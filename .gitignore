# Build output
/target/
**/*.rs.bk
*.pdb

# Test SSH keys are generated by scripts/test-dbs.sh
/tests/ssh/keys/

# UI test output; scripts/docs-screenshots.sh copies the ones the docs use into docs/images/
/docs/screenshots/*
!/docs/screenshots/.gitkeep

# Kittest snapshot diffs
**/*.new.png
**/*.diff.png
**/*.old.png

# Local app config and session when DBEAST_CONFIG points inside the repo
config.json
session.json
session.json.tmp
known_hosts

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
*~
.env
.env.*

# MkDocs build output
/site/
